{
  "name": "j2deme-slides",
  "version": "1.0.0",
  "scripts": {
    "slides": "python slides.py",
    "slides:pdf": "python slides.py --pdf",
    "slides:preview": "python slides.py --preview",
    "install:all": "npm install && pip install -r requirements.txt",
    "check:shiki": "node -e \"try{require('markdown-it-shiki');console.log('markdown-it-shiki OK')}catch(e){console.error('markdown-it-shiki not installed')}\""
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^3.4.0"
  },
  "marp": {
    "options": {
      "emoji": {
        "unicode": false,
        "shortcode": false
      }
    },
    "html": true,
    "allowLocalFiles": true,
    "math": "mathjax",
    "theme": "j2deme",
    "themeSet": "src/styles/j2deme.css",
    "author": "Jaime Jesús Delgado Meraz",
    "engine": "./engine.js"
  },
  "dependencies": {
    "@marp-team/marp-core": "^3.2.0",
    "gulp": "^5.0.0",
    "gulp-less": "^5.0.0",
    "gulp-sass": "^5.1.0",
    "inquirer": "^9.2.12",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-shiki": "^0.9.0"
  }
}